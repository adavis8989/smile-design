# fal.ai API key for AI smile generation
# Get your key at https://fal.ai/dashboard/keys
FAL_KEY=your_fal_ai_api_key

# Google Sheets integration for lead storage
# 1. Create a Google Cloud project and enable the Sheets API
# 2. Create a service account and download the JSON credentials
# 3. Create a Google Sheet with headers: Timestamp, First Name, Last Name, Email, Phone, Zip Code, Original Photo URL, Generated Photo URL
# 4. Share the sheet with the service account email (editor access)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEET_ID=your_google_sheet_id
