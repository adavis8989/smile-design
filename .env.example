# fal.ai API key for AI smile generation
# Get your key at https://fal.ai/dashboard/keys
FAL_KEY=your_fal_ai_api_key

# Monday.com integration for lead storage
# 1. Go to your Monday.com profile > Admin > API to get your token
# 2. Create a board with columns: Email (email type), Phone (phone type), Text (for zip code), Link (for photo URL)
# 3. Copy the board ID from the board URL (the number after /boards/)
MONDAY_API_TOKEN=your_monday_api_token
MONDAY_BOARD_ID=your_monday_board_id
